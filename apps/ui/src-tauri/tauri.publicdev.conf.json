{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "vector.dev (dev)",
  "mainBinaryName": "happier-desktop-dev",
  "identifier": "dev.vector.desktop.publicdev",
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "happier-dev"
        ]
      }
    },
    "updater": {
      "pubkey": "",
      "endpoints": []
    }
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "security": {
      "capabilities": [
        "default",
        "pet_overlay"
      ]
    },
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "vector.dev (dev)",
        "width": 800,
        "height": 600,
        "visible": false,
        "decorations": true,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "backgroundColor": "#F5F5F5",
        "dragDropEnabled": false,
        "resizable": true,
        "fullscreen": false
      }
    ]
  }
}
